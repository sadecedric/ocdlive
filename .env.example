# ============================================================
# OCD Live — variables d'environnement (toutes facultatives)
# ------------------------------------------------------------
# Sans ces variables le site fonctionne normalement : les
# réservations restent visibles dans /admin, seul l'envoi
# d'e-mail à l'équipe est désactivé.
#
# Sur Vercel : Project → Settings → Environment Variables,
# puis redéployer.
# ============================================================

# Clé API Resend (resend.com — offre gratuite : 100 e-mails/jour)
RESEND_API_KEY=

# Adresse qui reçoit les notifications de réservation
NOTIFY_EMAIL=contact@ocdlive.com

# Expéditeur affiché. Tant que le domaine n'est pas vérifié
# chez Resend, garder l'adresse de test ci-dessous.
NOTIFY_FROM=OCD Live <onboarding@resend.dev>
